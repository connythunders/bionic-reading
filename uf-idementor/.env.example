# Anthropic API – server-side endast. Lägg ALDRIG denna i klientkoden.
# Skapa nyckel på https://console.anthropic.com och lägg in den som
# Environment Variable i Vercel (Project Settings → Environment Variables).
ANTHROPIC_API_KEY=sk-ant-...

# Valfritt: model-id. Standard är claude-sonnet-4-6 (samma modell som den
# fristående uf-idementor.html använder).
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Valfritt: mjuk daglig gräns för antal mentor-svar (kostnadsskydd). Räknaren
# är per serverinstans och nollställs vid ny driftsättning/cold start – den
# är alltså ett grovt, inte exakt, skydd. Standard är 150 om denna utelämnas.
# Med claude-sonnet-4-6 och max_tokens=700 kostar ett mentor-svar
# uppskattningsvis 0,003-0,006 USD, så 150/dag ≈ max 0,5-1 USD/dag i
# värsta fall per serverinstans.
# MAX_REQUESTS_PER_DAY=150
