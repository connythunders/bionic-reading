# Kopiera denna fil till .env i projektroten - docker-compose läser den
# automatiskt och skickar in nyckeln till backend-containern.

# Anthropic API Key - används av quiz-generatorn, AI-feedbacken och
# den adaptiva provplattformen. Skapa en nyckel på:
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_api_key_here
