{
  "ci": {
    "collect": {
      "startServerCommand": "python3 -m http.server 4173 --directory ..",
      "startServerReadyPattern": "Serving HTTP",
      "url": [
        "http://localhost:4173/mattesteget/index.html",
        "http://localhost:4173/mattesteget/index.html#/lektion/procent-vardag-1",
        "http://localhost:4173/mattesteget/index.html#/ordlista"
      ],
      "numberOfRuns": 1,
      "settings": { "chromeFlags": "--no-sandbox", "formFactor": "mobile" }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
